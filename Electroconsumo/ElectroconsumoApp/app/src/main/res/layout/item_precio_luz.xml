<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card_esios"
    android:padding="14dp">

    <TextView
        android:id="@+id/txtHoraPrecio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="12:00 - 13:00"
        android:textColor="@color/titulo_principal"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/txtPeriodoPrecio"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtPeriodoPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_esios"
        android:paddingStart="9dp"
        android:paddingTop="3dp"
        android:paddingEnd="9dp"
        android:paddingBottom="3dp"
        android:text="LLANO"
        android:textColor="@color/naranja_llano"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtFechaPrecio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="22/06/2026"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtHoraPrecio" />

    <TextView
        android:id="@+id/txtValorPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0,112 €/kWh"
        android:textColor="@color/titulo_principal"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtFechaPrecio" />

    <TextView
        android:id="@+id/txtValorMwhPrecio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:baselineAligned="false"
        android:text="111,78 €/MWh"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/txtValorPrecio"
        app:layout_constraintStart_toEndOf="@id/txtValorPrecio" />

    <ProgressBar
        android:id="@+id/progresoPrecio"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:max="100"
        android:progress="50"
        android:progressTint="@color/azul_principal"
        android:progressBackgroundTint="#EEF3F8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtValorPrecio" />

    <TextView
        android:id="@+id/txtZonaPrecio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Península"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/progresoPrecio" />

</androidx.constraintlayout.widget.ConstraintLayout>
