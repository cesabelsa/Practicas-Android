<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_principal" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarMiPerfil" android:layout_width="match_parent" android:layout_height="88dp" android:background="@drawable/bg_toolbar_moderno" android:navigationIcon="@drawable/ic_arrow_back" android:title="@string/titulo_mi_perfil" android:titleTextColor="@color/texto_blanco" app:navigationIconTint="@color/texto_blanco" android:paddingTop="24dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="8dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetStart="0dp" app:titleTextColor="@color/texto_blanco" app:navigationIcon="@drawable/ic_arrow_back" app:menu="@menu/menu_toolbar_secundaria" app:title="Mi perfil" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="24dp" android:paddingTop="28dp" android:paddingEnd="24dp" android:paddingBottom="32dp">
            <TextView android:id="@+id/txtPerfilAvatar" android:layout_width="88dp" android:layout_height="88dp" android:background="@drawable/bg_avatar_toolbar" android:gravity="center" android:text="U" android:textColor="@color/texto_blanco" android:textSize="34sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtPerfilNombre" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="Usuario" android:textColor="@color/titulo_principal" android:textSize="24sp" android:textStyle="bold" />
            <TextView android:id="@+id/txtPerfilEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="correo@ejemplo.com" android:textColor="@color/texto_secundario" android:textSize="15sp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" app:cardCornerRadius="10dp" app:cardElevation="0dp" app:strokeColor="@color/card_borde" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/perfil_datos_cuenta" android:textColor="@color/titulo_principal" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/perfil_etiqueta_nombre" android:textColor="@color/texto_secundario" android:textSize="13sp" />
                    <TextView android:id="@+id/txtPerfilNombreDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Usuario" android:textColor="@color/texto_principal" android:textSize="16sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/perfil_etiqueta_email" android:textColor="@color/texto_secundario" android:textSize="13sp" />
                    <TextView android:id="@+id/txtPerfilEmailDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="correo@ejemplo.com" android:textColor="@color/texto_principal" android:textSize="16sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/perfil_etiqueta_sesion" android:textColor="@color/texto_secundario" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/perfil_sesion_activa" android:textColor="@color/texto_principal" android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPerfilAjustes" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:minHeight="52dp" android:text="@string/perfil_abrir_ajustes" android:textAllCaps="false" app:cornerRadius="10dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPerfilCerrarSesion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="52dp" android:text="@string/menu_cerrar_sesion" android:textAllCaps="false" app:backgroundTint="@color/boton_primario" app:cornerRadius="10dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="@string/perfil_edicion_pendiente" android:textColor="@color/texto_secundario" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>