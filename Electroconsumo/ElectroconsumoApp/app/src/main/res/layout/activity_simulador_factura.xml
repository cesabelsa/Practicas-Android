            <TextView android:id="@+id/txtCostePeriodos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Coste P1: 0,00 € · P2: 0,00 € · P3: 0,00 €" android:textColor="@color/texto_secundario"/>
            <TextView android:id="@+id/txtTotalEnergia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Energía consumida: 0,00 €" android:textColor="@color/texto_principal" android:textSize="15sp"/>
            <TextView android:id="@+id/txtTotalPotencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Potencia contratada: 0,00 €" android:textColor="@color/texto_principal" android:textSize="15sp"/>
            <TextView android:id="@+id/txtTotalImpuestos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Imp. electricidad + IVA: 0,00 €" android:textColor="@color/texto_principal" android:textSize="15sp"/>
            <TextView android:id="@+id/txtResumenDesglose" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Base energía+potencia: 0,00 € · Alquiler contador: 0,00 € · IEE: 0,00 € · IVA: 0,00 €" android:textColor="@color/texto_secundario" android:textSize="13sp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aviso: es una simulación. Para precio fijo del mercado libre usa el precio de tu contrato; para PVPC o indexadas puedes usar precios ESIOS guardados." android:textColor="@color/texto_secundario" android:textSize="13sp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCompararTarifas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/simulador_comparar_tarifas"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnGuardarSimulacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/simulador_guardar"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnVerHistorial" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/simulador_ver_historial"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnVolverFactura" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Volver a uso"/>
