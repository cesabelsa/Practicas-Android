<?xml version='1.0' encoding='UTF-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_principal">
  <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarSimulador" android:layout_width="0dp" android:layout_height="88dp" android:background="@drawable/bg_toolbar_moderno" android:paddingTop="24dp" app:title="@string/simulador_titulo" app:titleTextColor="@color/texto_blanco" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="8dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetStart="0dp" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/texto_blanco" app:menu="@menu/menu_toolbar_secundaria"/>
  <com.google.android.material.tabs.TabLayout android:id="@+id/tabLayoutFactura" android:layout_width="0dp" android:layout_height="wrap_content" android:background="@color/fondo_blanco" app:tabGravity="fill" app:tabMode="fixed" app:tabIndicatorColor="@color/titulo_principal" app:tabSelectedTextColor="@color/titulo_principal" app:tabTextColor="@color/texto_secundario" app:tabIndicatorFullWidth="false" app:tabRippleColor="@android:color/transparent" android:elevation="2dp" app:layout_constraintTop_toBottomOf="@id/toolbarSimulador" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
  <FrameLayout android:id="@+id/contenedorTabsFactura" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toBottomOf="@id/tabLayoutFactura" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
    <ScrollView android:id="@+id/tabHogar" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp" app:strokeColor="@color/azul_claro" app:strokeWidth="1dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulador_seccion_datos_hogar" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selecciona la categoría y el electrodoméstico. La app carga sus datos desde SQLite y propone una potencia media editable." android:textColor="@color/texto_secundario" android:textSize="13sp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Electrodoméstico" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <Spinner android:id="@+id/spinnerCategoria" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp"/>
            <Spinner android:id="@+id/spinnerElectrodomestico" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp"/>
            <TextView android:id="@+id/txtDatosElectrodomestico" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Datos del electrodoméstico" android:textColor="@color/texto_secundario" android:textSize="13sp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSiguienteHogar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulador_siguiente_uso"/>
      </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/tabUso" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulador_seccion_uso" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundMode="outline">
              <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPotenciaManual" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Potencia usada en W" android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtHorasDia" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Horas/día" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDiasMes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Días/mes" android:inputType="number"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" app:boxBackgroundMode="outline" app:helperText="100 % usa toda la potencia indicada; 50 % usa la mitad.">
              <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPorcentajeUso" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Porcentaje de uso de potencia (%)" android:inputType="numberDecimal" android:text="100"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Periodo habitual de uso" android:textColor="@color/titulo_principal" android:textStyle="bold"/>
            <Spinner android:id="@+id/spinnerPeriodoUso" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Periodo horario de uso"/>
            <TextView android:id="@+id/txtAyudaPeriodoUso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="4dp" android:text="Puedes elegir P1/P2/P3 o dejar que la app calcule el periodo mediante el día y la hora de inicio." android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            <LinearLayout android:id="@+id/panelHorarioAutomatico" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tipo de día" android:textColor="@color/titulo_principal" android:textStyle="bold"/>
              <Spinner android:id="@+id/spinnerTipoDia" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Tipo de día para calcular el periodo 2.0TD"/>
              <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtHoraInicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Hora de inicio (0-23,99)" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp" android:text="En sábados, domingos y festivos nacionales no sustituibles se aplica P3 durante todo el día." android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAnadirLinea" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Añadir electrodoméstico" android:layout_marginTop="10dp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Líneas añadidas" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <com.example.consumoapp.factura.FullyExpandedRecyclerView
                android:id="@+id/recyclerLineasFactura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
          <com.google.android.material.button.MaterialButton android:id="@+id/btnVolverUso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Volver"/>
          <com.google.android.material.button.MaterialButton android:id="@+id/btnSiguienteUso" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:text="Siguiente: tarifa y factura"/>
        </LinearLayout>
      </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/tabFactura" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Contrato, regulados e impuestos" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Puedes cargar valores 2.0TD 2026 y después corregirlos con los importes reales de tu factura." android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tarifa y precios de la factura" android:textColor="@color/titulo_principal" android:textStyle="bold"/>
            <RadioGroup android:id="@+id/radioGrupoFuentePrecio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical">
              <RadioButton android:id="@+id/radioEsios" android:layout_width="match_parent" android:layout_height="wrap_content" android:checked="true" android:text="PVPC / ESIOS"/>
              <RadioButton android:id="@+id/radioComercializadora" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tarifa de comercializadora"/>
              <RadioButton android:id="@+id/radioManual" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Introducir precios manualmente"/>
            </RadioGroup>
            <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:boxBackgroundMode="outline">
              <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPrecioKwh" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Precio manual de energía €/kWh" android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnUsarPrecioEsios" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargar precios ESIOS guardados" android:layout_marginTop="8dp"/>
            <LinearLayout android:id="@+id/panelComercializadora" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" android:visibility="gone">
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Comercializadora"/>
              <Spinner android:id="@+id/spinnerComercializadora" android:layout_width="match_parent" android:layout_height="48dp"/>
              <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tarifa"/>
              <Spinner android:id="@+id/spinnerTarifa" android:layout_width="match_parent" android:layout_height="48dp"/>
              <TextView android:id="@+id/txtResumenTarifaSeleccionada" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card_esios" android:padding="12dp" android:text="Selecciona una tarifa para ver sus precios." android:textColor="@color/texto_principal" android:textSize="13sp"/>
            </LinearLayout>
            <TextView android:id="@+id/txtAvisoFuentePrecio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Selecciona la fuente de precios. El coste se calculará únicamente al generar la factura." android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPotenciaPuntaKw" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="kW punta" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPotenciaValleKw" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="kW valle" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPrecioPotenciaPunta" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="€/kW día P1" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtPrecioPotenciaValle" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="€/kW día P2" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtDiasFactura" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Días factura" android:inputType="number"/>
              </com.google.android.material.textfield.TextInputLayout>
              <com.google.android.material.textfield.TextInputLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" app:boxBackgroundMode="outline">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/edtAlquilerContadorDia" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Contador €/día" android:inputType="numberDecimal"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
