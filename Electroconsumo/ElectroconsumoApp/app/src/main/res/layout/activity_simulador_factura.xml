            <TextView android:id="@+id/txtAyudaPrecioSoloMercado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Actívalo únicamente si el precio introducido no incluye peajes ni cargos. En PVPC/ESIOS y tarifas comerciales debe permanecer desactivado." android:textColor="@color/texto_secundario" android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/btnCargarConstantes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Cargar constantes vigentes"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCalcularFactura" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="@string/simulador_calcular_factura"/>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/titulo_principal" app:cardCornerRadius="16dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/simulador_seccion_resultado" android:textColor="@color/texto_blanco" android:textStyle="bold" android:textSize="17sp"/>
            <TextView android:id="@+id/txtFuenteResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Fuente: PVPC / ESIOS" android:textColor="@color/texto_blanco" android:textSize="13sp"/>
            <TextView android:id="@+id/txtTotalFactura" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Total aproximado: 0,00 €" android:textColor="@color/texto_blanco" android:textStyle="bold" android:textSize="28sp"/>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="14dp" app:cardElevation="2dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Desglose" android:textColor="@color/titulo_principal" android:textStyle="bold" android:textSize="17sp"/>
            <TextView android:id="@+id/txtTotalConsumo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Consumo electrodomésticos: 0,00 kWh" android:textColor="@color/texto_principal" android:textSize="15sp"/>
