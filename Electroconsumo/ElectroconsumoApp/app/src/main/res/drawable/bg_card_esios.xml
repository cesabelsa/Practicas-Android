<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Fondo blanco como el resto del proyecto. -->
    <solid android:color="@color/card_fondo" />

    <!-- Borde gris suave reutilizando la paleta existente. -->
    <stroke
        android:width="1dp"
        android:color="@color/card_borde" />

    <!-- Esquinas redondeadas como los campos y botones del login. -->
    <corners android:radius="14dp" />

    <!-- Espacio interno visual de la tarjeta. -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
