<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo circular del avatar usado en la toolbar y en la pantalla Mi perfil. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">

    <!-- Utiliza el color principal de la aplicación. -->
    <solid android:color="@color/boton_primario" />

    <!-- Borde blanco sutil para separar el avatar del fondo. -->
    <stroke
        android:width="1dp"
        android:color="@color/texto_blanco" />
</shape>
