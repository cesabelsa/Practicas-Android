<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="resumen"
            type="com.example.consumoapp.esios.ui.ResumenPrecio" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fondo_principal"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <TextView
        android:fontFamily="@font/circular_std"
                android:id="@+id/txtTituloResumen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Resumen del precio de la luz"
                android:textColor="@color/titulo_principal"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtSubtituloResumen"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Datos descargados desde la API de ESIOS y guardados localmente."
                android:textColor="@color/texto_secundario"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/txtTituloResumen"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
        android:fontFamily="@font/circular_std"
                android:id="@+id/txtPrecioActual"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card_esios"
                android:minHeight="72dp"
                android:padding="18dp"
                android:text='@{"Precio actual\n" + resumen.precioActual}'
                android:textColor="@color/titulo_principal"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/txtSubtituloResumen"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtPrecioMedio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_esios"
                android:minHeight="72dp"
                android:padding="18dp"
                android:text='@{"Precio medio\n" + resumen.precioMedio}'
                android:textColor="@color/titulo_principal"
                android:textSize="18sp"
                app:layout_constraintTop_toBottomOf="@id/txtPrecioActual"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtPrecioMinimo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card_esios"
                android:minHeight="76dp"
                android:padding="18dp"
                android:text='@{"Precio mínimo\n" + resumen.precioMinimo}'
                android:textColor="@color/titulo_principal"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/txtPrecioMedio"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/txtPrecioMaximo" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtPrecioMaximo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_esios"
                android:minHeight="76dp"
                android:padding="18dp"
                android:text='@{"Precio máximo\n" + resumen.precioMaximo}'
                android:textColor="@color/titulo_principal"
                android:textSize="17sp"
                app:layout_constraintTop_toBottomOf="@id/txtPrecioMedio"
                app:layout_constraintStart_toEndOf="@id/txtPrecioMinimo"
                app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.button.MaterialButton
        android:fontFamily="@font/circular_std"
                android:id="@+id/btnActualizarResumen"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Actualizar desde ESIOS"
                android:textColor="@color/boton_primario_texto"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/boton_primario"
                app:cornerRadius="8dp"
                app:layout_constraintTop_toBottomOf="@id/txtPrecioMinimo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>
