<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_principal">
    <ScrollView android:id="@+id/scrollLogin" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="24dp">
            <ImageView android:id="@+id/imgLoginEnchufe" android:layout_width="0dp" android:layout_height="280dp" android:adjustViewBounds="true" android:contentDescription="@string/imagen_principal" android:scaleType="fitCenter" android:src="@drawable/solar_house" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
            <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtConectate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conéctate" android:textColor="@color/titulo_principal" android:textSize="28sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/imgLoginEnchufe" />
            <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtSubtituloLogin" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:layout_marginTop="2dp" android:gravity="center" android:text="Inicia sesión para acceder a tu cuenta" android:textColor="@color/texto_secundario" android:textSize="14sp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/txtConectate" />
            <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/contenedorFormularioLogin" android:layout_width="0dp" android:layout_height="270dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:layout_marginTop="18dp" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/txtSubtituloLogin">
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutUsuario" android:layout_width="0dp" android:layout_height="wrap_content" android:hint="Usuario" app:boxBackgroundColor="@color/campo_fondo" app:boxBackgroundMode="outline" app:boxCornerRadiusBottomEnd="8dp" app:boxCornerRadiusBottomStart="8dp" app:boxCornerRadiusTopEnd="8dp" app:boxCornerRadiusTopStart="8dp" app:boxStrokeColor="@color/campo_borde_activo" app:hintTextColor="@color/campo_hint" app:startIconDrawable="@drawable/ic_usuario" app:startIconTint="@color/icono_principal" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent">
                    <com.google.android.material.textfield.TextInputEditText android:fontFamily="@font/titillium_web" android:id="@+id/edtUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:textColor="@color/campo_texto" android:textColorHint="@color/campo_hint" android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
