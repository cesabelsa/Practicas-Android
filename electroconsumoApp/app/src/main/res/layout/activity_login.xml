                    <com.google.android.material.textfield.TextInputEditText android:fontFamily="@font/titillium_web" android:id="@+id/edtPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColor="@color/campo_texto" android:textColorHint="@color/campo_hint" android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>
                <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtOlvidastePassword" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="¿Olvidaste tu contraseña?" android:textColor="@color/link" android:textSize="13sp" android:textStyle="bold" app:layout_constraintEnd_toEndOf="@id/layoutPassword" app:layout_constraintTop_toBottomOf="@id/layoutPassword" />
                <com.google.android.material.button.MaterialButton android:fontFamily="@font/circular_std" android:id="@+id/btnEntrar" android:layout_width="0dp" android:layout_height="56dp" android:text="Entrar" android:textColor="@color/boton_primario_texto" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/boton_primario" app:cornerRadius="8dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" />
