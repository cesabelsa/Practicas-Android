<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
        android:fontFamily="@font/circular_std"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gráfico del día"
            android:textColor="@color/titulo_principal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
        android:fontFamily="@font/titillium_web"
            android:id="@+id/txtEstadoGrafico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Sin datos guardados. Actualiza desde ESIOS."
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_esios"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
        android:fontFamily="@font/circular_std"
                android:id="@+id/txtResumenGrafico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Precio medio: Sin datos"
                android:textColor="@color/titulo_principal"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="00:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/verde_valle"
                android:textSize="16sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="01:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/verde_valle"
                android:textSize="16sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="02:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/verde_valle"
                android:textSize="16sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="03:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/verde_valle"
                android:textSize="16sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="04:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/naranja_llano"
                android:textSize="16sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/txtBarra6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="05:00  Sin datos"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp" />

            <TextView
        android:fontFamily="@font/titillium_web"
                android:id="@+id/barra6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="███"
                android:textColor="@color/rojo_punta"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
