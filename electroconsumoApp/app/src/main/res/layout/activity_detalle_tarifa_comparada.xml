<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_app" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarDetalleTarifa" android:layout_width="match_parent" android:layout_height="88dp" android:background="@drawable/bg_toolbar_moderno" app:title="Detalle de la tarifa" app:titleTextColor="@color/texto_blanco" android:paddingTop="24dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="8dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetStart="0dp" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/texto_blanco" app:menu="@menu/menu_toolbar_secundaria" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="16dp" app:cardElevation="3dp" app:strokeColor="@color/card_borde" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleComercializadora" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Comercializadora" android:textColor="@color/titulo_principal" android:textSize="20sp" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleNombreTarifa" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Tarifa" android:textColor="@color/texto_principal" android:textSize="17sp" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleTipoTarifa" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_sello_estimacion" android:paddingHorizontal="10dp" android:paddingVertical="5dp" android:text="Tipo" android:textColor="@color/titulo_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="0,00 €" android:textColor="@color/titulo_principal" android:textSize="30sp" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleProyeccion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Periodo y proyección" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleAhorro" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Ahorro" android:textColor="@color/titulo_principal" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:fontFamily="@font/circular_std" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Desglose estimado" android:textColor="@color/titulo_principal" android:textSize="17sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="14dp" app:strokeColor="@color/card_borde" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Energía" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleEnergia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Potencia" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetallePotencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Impuesto eléctrico" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleImpuesto" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="IVA" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleIva" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:text="Alquiler del contador" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleAlquiler" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="12dp" android:background="@color/card_borde" />
                    <TextView android:fontFamily="@font/circular_std" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Total" android:textColor="@color/titulo_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetalleTotalDesglose" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0,00 €" android:textColor="@color/titulo_principal" android:textSize="21sp" android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:fontFamily="@font/circular_std" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Precios y condiciones" android:textColor="@color/titulo_principal" android:textSize="17sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="14dp" app:strokeColor="@color/card_borde" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                    <TextView android:fontFamily="@font/titillium_web" android:text="Precios de energía" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtDetallePrecios" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="P1 P2 P3" android:textColor="@color/texto_principal" android:textStyle="bold" />
                    <TextView android:fontFamily="@font/titillium_web" android:text="Permanencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetallePermanencia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                    <TextView android:fontFamily="@font/titillium_web" android:text="Descuento" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleDescuento" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                    <TextView android:fontFamily="@font/titillium_web" android:text="Servicios adicionales" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleServicios" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                    <TextView android:fontFamily="@font/titillium_web" android:text="Actualización" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleActualizacion" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                    <TextView android:fontFamily="@font/titillium_web" android:text="Fuente" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleFuente" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleObservacionesTitulo" android:text="Observaciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/texto_secundario" />
                    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtDetalleObservaciones" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No informado" android:textColor="@color/texto_principal" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:fontFamily="@font/titillium_web" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_factura_titulo_seccion" android:padding="12dp" android:text="Comparación estimada. Verifica siempre las condiciones, la fecha y la fuente de la oferta antes de contratar." android:textColor="@color/texto_principal" android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>