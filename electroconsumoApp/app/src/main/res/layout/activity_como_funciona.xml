<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_principal"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarComoFunciona"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@drawable/bg_toolbar_moderno"
        android:navigationIcon="@drawable/ic_arrow_back"
        android:paddingStart="8dp"
        android:paddingTop="24dp"
        android:paddingEnd="8dp"
        android:title="Cómo funciona"
        android:titleTextColor="@color/texto_blanco"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIconTint="@color/texto_blanco"
        app:titleTextColor="@color/texto_blanco" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/circular_std"
                android:text="Guía de Electroconsumo"
                android:textColor="@color/titulo_principal"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/titillium_web"
                android:lineSpacingExtra="3dp"
                android:text="Electroconsumo te ayuda a consultar el precio horario de la electricidad, estimar el importe de una factura y comparar distintas opciones de consumo. Los resultados son orientativos y pueden variar respecto a la factura real de tu comercializadora."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/circular_std"
                android:text="Cómo usar la aplicación"
                android:textColor="@color/titulo_principal"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/circular_std"
                android:text="1. Consulta el precio de la luz"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/titillium_web"
                android:lineSpacingExtra="2dp"
                android:text="En Precio de la luz (ESIOS) puedes ver los precios por hora, localizar las horas más económicas y consultar gráficos y resúmenes del día."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/circular_std"
                android:text="2. Simula tu factura"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/titillium_web"
                android:lineSpacingExtra="2dp"
                android:text="Introduce los datos del contrato, el periodo de facturación y el consumo. La aplicación calcula una estimación con energía, potencia, impuestos y otros conceptos regulados."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/circular_std"
                android:text="3. Añade tus electrodomésticos"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/titillium_web"
                android:lineSpacingExtra="2dp"
                android:text="Indica la potencia y las horas de uso para aproximar el consumo de cada aparato y entender qué elementos influyen más en el gasto."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/circular_std"
                android:text="4. Revisa y compara"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/titillium_web"
                android:lineSpacingExtra="2dp"
                android:text="Consulta el desglose final, guarda simulaciones y compara alternativas desde las opciones internas del simulador."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:fontFamily="@font/circular_std"
                android:text="Glosario"
                android:textColor="@color/titulo_principal"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/circular_std"
                android:text="kWh · Kilovatio hora"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Unidad que mide la energía consumida. Por ejemplo, un aparato de 1 kW encendido durante una hora consume 1 kWh."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="kW · Kilovatio"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Unidad de potencia. Indica la cantidad de energía que un aparato necesita en un momento determinado."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="Potencia contratada"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Límite de potencia que puedes utilizar al mismo tiempo. Se paga aunque no consumas energía."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="PVPC"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Precio Voluntario para el Pequeño Consumidor. Es una tarifa regulada cuyo precio puede cambiar según la hora."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="ESIOS"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Sistema de información del operador eléctrico del que la aplicación obtiene los datos de precios utilizados en la consulta."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="Peajes y cargos"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Costes regulados relacionados con el transporte, la distribución y otros componentes del sistema eléctrico."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="Periodo punta, llano y valle"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Franjas horarias que pueden tener precios diferentes. Punta suele ser la más cara, llano intermedia y valle la más económica."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/circular_std"
                android:text="Consumo estimado"
                android:textColor="@color/texto_principal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/titillium_web"
                android:text="Cálculo aproximado basado en los datos que introduces. No sustituye la lectura real del contador ni una factura oficial."
                android:textColor="@color/texto_secundario"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
