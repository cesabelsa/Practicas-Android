<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_blanco" android:orientation="vertical" android:padding="0dp">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarRecuperar" android:layout_width="match_parent" android:layout_height="88dp" android:background="@drawable/bg_toolbar_moderno" android:paddingTop="24dp" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/texto_blanco" app:title="Recuperar contraseña" app:titleTextColor="@color/texto_blanco" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="8dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetStart="0dp" app:menu="@menu/menu_toolbar_secundaria" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="28dp">
        <ImageView android:id="@+id/imgRecuperar" android:layout_width="150dp" android:layout_height="150dp" android:layout_gravity="center_horizontal" android:layout_marginTop="40dp" android:src="@drawable/solar_house" />
        <TextView android:fontFamily="@font/circular_std" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recuperar contraseña" android:textColor="@color/azul_principal" android:textSize="28sp" android:textStyle="bold" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" />
        <TextView android:fontFamily="@font/titillium_web" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Introduce tu correo y una contraseña nueva" android:textColor="@color/azul_principal" android:textSize="14sp" android:layout_gravity="center_horizontal" android:layout_marginTop="10dp" />
        <EditText android:fontFamily="@font/titillium_web" android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="30dp" android:hint="Correo electrónico" android:inputType="textEmailAddress" android:background="@drawable/bg_input_login" />
        <EditText android:fontFamily="@font/titillium_web" android:id="@+id/edtNuevaPassword" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" android:hint="Nueva contraseña" android:inputType="textPassword" android:background="@drawable/bg_input_login" />
        <Button android:fontFamily="@font/circular_std" android:id="@+id/btnEnviar" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Actualizar contraseña" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_boton_login" />
        <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtVolverLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Volver al login" android:textColor="@color/azul_principal" android:textStyle="bold" android:textSize="15sp" android:layout_gravity="center_horizontal" android:layout_marginTop="20dp" />
    </LinearLayout>
</LinearLayout>