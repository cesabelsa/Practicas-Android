<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/fondo_principal">
    <ScrollView android:id="@+id/scrollOnboarding" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="16dp">
            <ImageView android:id="@+id/imgPortada" android:layout_width="0dp" android:layout_height="280dp" android:adjustViewBounds="true" android:contentDescription="@string/imagen_principal" android:scaleType="fitCenter" android:src="@drawable/onboarding_image" app:layout_constraintBottom_toTopOf="@id/layoutTitulos" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintVertical_chainStyle="packed" />
            <LinearLayout android:id="@+id/layoutTitulos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" app:layout_constraintBottom_toTopOf="@id/txtSubtitulo" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/imgPortada">
                <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtTitulo1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Controla tu consumo," android:textColor="@color/titulo_principal" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtTitulo2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ahorra en tu factura" android:textColor="@color/link" android:textSize="18sp" android:textStyle="bold" />
            </LinearLayout>
            <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtSubtitulo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:lineSpacingExtra="2dp" android:text="Consulta el precio de la luz en tiempo real, descubre las horas valle y calcula cuándo ahorrar fácilmente." android:textColor="@color/texto_secundario" android:textSize="13sp" app:layout_constraintBottom_toTopOf="@id/btnComenzar" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/layoutTitulos" />
            <com.google.android.material.button.MaterialButton android:fontFamily="@font/circular_std" android:id="@+id/btnComenzar" android:layout_width="0dp" android:layout_height="56dp" android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:layout_marginTop="12dp" android:text="COMENZAR" android:textColor="@color/boton_primario_texto" android:textSize="16sp" android:textStyle="bold" app:backgroundTint="@color/boton_primario" app:cornerRadius="8dp" app:layout_constraintBottom_toTopOf="@id/layoutLogin" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/txtSubtitulo" />
            <LinearLayout android:id="@+id/layoutLogin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/btnComenzar">
                <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtYaTienesCuenta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="¿Ya tienes cuenta?" android:textColor="@color/texto_secundario" android:textSize="12sp" />
                <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtIniciaSesion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:clickable="true" android:focusable="true" android:text="Inicia sesión" android:textColor="@color/link" android:textSize="12sp" android:textStyle="bold" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>