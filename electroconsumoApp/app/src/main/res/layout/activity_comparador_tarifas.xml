<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/fondo_secundario">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbarComparador" android:layout_width="match_parent" android:layout_height="88dp" android:background="@drawable/bg_toolbar_moderno" app:title="Comparador de tarifas" app:titleTextColor="@color/texto_blanco" android:paddingTop="24dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:elevation="8dp" app:contentInsetStartWithNavigation="0dp" app:contentInsetStart="0dp" app:navigationIcon="@drawable/ic_arrow_back" app:navigationIconTint="@color/texto_blanco" app:menu="@menu/menu_toolbar_secundaria" />
    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtResumenComparador" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="Consumo utilizado para comparar" android:textColor="@color/texto_principal" android:textSize="15sp" />
    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtMejorOpcion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:layout_marginBottom="10dp" android:background="@drawable/bg_factura_titulo_seccion" android:padding="12dp" android:text="Mejor resultado" android:textColor="@color/titulo_principal" android:textStyle="bold" android:visibility="gone" />
    <TextView android:fontFamily="@font/titillium_web" android:id="@+id/txtAvisoComparador" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp" android:text="Comparación estimada con el mismo perfil de consumo. Revisa fecha, fuente, permanencia, descuentos y servicios antes de contratar." android:textColor="@color/texto_secundario" android:textSize="12sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none" android:paddingStart="12dp" android:paddingEnd="12dp">
        <com.google.android.material.chip.ChipGroup android:id="@+id/chipGroupFiltros" android:layout_width="wrap_content" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/chipTodas" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="@string/comparador_filtro_todas" />
            <com.google.android.material.chip.Chip android:id="@+id/chipSinPermanencia" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comparador_filtro_sin_permanencia" />
            <com.google.android.material.chip.Chip android:id="@+id/chipPrecioUnico" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comparador_filtro_precio_unico" />
            <com.google.android.material.chip.Chip android:id="@+id/chipTresPeriodos" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comparador_filtro_tres_periodos" />
            <com.google.android.material.chip.Chip android:id="@+id/chipConDescuento" style="@style/Widget.MaterialComponents.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/comparador_filtro_descuento" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <Spinner android:id="@+id/spinnerOrdenComparador" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginStart="16dp" android:layout_marginEnd="16dp" android:contentDescription="@string/comparador_orden_descripcion" android:entries="@array/comparador_opciones_orden" />
    <TextView android:fontFamily="@font/circular_std" android:id="@+id/txtNumeroTarifas" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="8dp" android:text="Calculando tarifas…" android:textColor="@color/titulo_principal" android:textStyle="bold" />
    <ProgressBar android:id="@+id/progressComparador" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerComparador" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="10dp" android:clipToPadding="false" />
</LinearLayout>